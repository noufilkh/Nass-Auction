<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>AutoBid - Premium Car Auctions</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <!-- Font Awesome for icons -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <!-- Google Fonts -->
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/VechileAuctionApp.styles.css" asp-append-version="true" />

</head>

<body>
        @await Component.InvokeAsync("Navbar")

        <header class="hero-section text-center">
            <div class="container">
                <h1 class="display-4 fw-bold mb-3">Used Online Car Auctions</h1>
                <p class="lead mb-4">Discover, bid, and win exclusive vehicles from trusted sellers nationwide.</p>
                @* <a href="#auctions" class="btn btn-danger btn-lg rounded-pill px-5">View Live Auctions</a> *@
            </div>
        </header>

        @RenderBody()

        <footer>
            <div class="container">
                <div class="row gy-4">
                    <div class="col-lg-4 col-md-6">
                        <h5 class="fw-bold mb-3"><i class="fas fa-gavel me-2"></i>AutoBid</h5>
                        <p class="text-muted small">The premier destination for buying and selling high-quality, exotic, and
                            classic cars through our secure online auction platform.</p>
                        </div>
                        <div class="col-lg-2 col-md-6">
                            <h5 class="fw-bold mb-3">Quick Links</h5>
                            <ul class="list-unstyled text-muted small">
                                <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Live Auctions</a></li>
                                <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Past Results</a></li>
                                <li class="mb-2"><a href="#" class="text-decoration-none text-muted">Sell a Car</a></li>
                                <li class="mb-2"><a href="#" class="text-decoration-none text-muted">FAQ</a></li>
                            </ul>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h5 class="fw-bold mb-3">Contact Us</h5>
                            <ul class="list-unstyled text-muted small">
                                <li class="mb-2"><i class="fas fa-envelope me-2"></i> support@autobid.example</li>
                                <li class="mb-2"><i class="fas fa-phone me-2"></i> +1 (555) 123-4567</li>
                                <li class="mb-2"><i class="fas fa-map-marker-alt me-2"></i> 123 Auction Way, NY 10001</li>
                            </ul>
                        </div>
                        <div class="col-lg-3 col-md-6">
                            <h5 class="fw-bold mb-3">Newsletter</h5>
                            <p class="text-muted small">Subscribe for updates on rare finds and upcoming auctions.</p>
                            <div class="input-group mb-3">
                                <input type="email" class="form-control bg-dark text-white border-secondary"
                                       placeholder="Email address" aria-label="Email address">
                                <button class="btn btn-danger" type="button">Subscribe</button>
                            </div>
                        </div>
                    </div>
                    <hr class="border-secondary mt-4 mb-3">
                    <div class="text-center text-muted small">
                        &copy; 2026 AutoBid Auctions. All rights reserved.
                    </div>
                </div>
            </footer>

    

            <!-- Bootstrap JS Bundle with Popper -->
            <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
            
        </body>

    </html>

