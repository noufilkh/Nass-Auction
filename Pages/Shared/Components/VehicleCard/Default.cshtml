@model List<VechileAuctionApp.Models.Vehicle>

<style>
    /* Car Card styling */
    .car-card {
        border: 1px solid #1153B890;
        border-radius: 12px;
        overflow: hidden;
        box-shadow: 0 4px 6px rgba(0, 0, 0, 0.05);
        transition:
            transform 0.3s ease,
            box-shadow 0.3s ease;
        height: 100%;
        background-color: #ffffff;

    }

    .car-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 10px 20px rgba(0, 0, 0, 0.1);
    }

    .car-card img {
        height: 200px;
        object-fit: cover;
        width: 100%;
    }

    .car-badge {
        position: absolute;
        top: 10px;
        right: 10px;
        background-color: #1153B8;
        color: white;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 0.8rem;
        font-weight: bold;
    }

    .car-info-row {
        display: flex;
        justify-content: space-between;
        font-size: 0.85rem;
        color: #6c757d;
        margin-bottom: 10px;
        border-bottom: 1px solid #eee;
        padding-bottom: 10px;
    }

    .car-price {
        font-size: 1.25rem;
        font-weight: 700;
        color: #2e7d32;
    }

    .time-left {
        color: #d32f2f;
        font-weight: 600;
        font-size: 0.9rem;
    }

    .btn-bid {
        background-color: #1153B8;
        color: white;
        font-weight: 600;
        border: none;
        width: 100%;
    }

    .btn-bid:hover {
        background-color: #1153B8;
        color: white;
    }
</style>

@if (Model.Count > 0)
{
    @foreach (VechileAuctionApp.Models.Vehicle vehicle in Model)
    {
        <div class="col">
            <div class="card car-card position-relative">
                @if (vehicle.Badge.Length > 0)
                {
                    <span class="car-badge"><i class="fas @vehicle.BadgeIcon me-1"></i>@vehicle.Badge</span>
                }
                <img src="@vehicle.ImageURL" class="card-img-top" alt="BMW M4"
                     onerror="this.src='https://placehold.co/600x400/eeeeee/999999?text=BMW+M4'">
                <div class="card-body">
                    <h5 class="card-title fw-bold text-truncate" title="@vehicle.Year @vehicle.Brand @vehicle.Model">
                        @vehicle.Year @vehicle.Brand @vehicle.Model</h5>
                        <div class="car-info-row mt-3">
                            <span><i class="fas fa-tachometer-alt me-1"></i>@vehicle.Milleage mi</span>
                            <span><i class="fas fa-cog me-1"></i>@vehicle.Transmission</span>
                            <span><i class="fas fa-gas-pump me-1"></i>@vehicle.Fuel</span>
                        </div>
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="d-block text-muted small">Current Bid</span>
                                <span class="car-price">@vehicle.CurrentBid</span>
                            </div>
                            <div class="text-end">
                                <span class="d-block text-muted small">Ends In</span>
                                <span class="time-left"><i class="far fa-clock"></i>&nbsp;&nbsp;@vehicle.Ends</span>
                            </div>
                        </div>
                        <!-- Assuming the variable model/property is Model.VehicleId or item.Id -->
                        <a asp-page="/VehicleDetails" asp-route-id="@vehicle.Id" class="btn btn-bid">Place Bid</a>

                    </div>
                </div>
            </div>
        }
    }