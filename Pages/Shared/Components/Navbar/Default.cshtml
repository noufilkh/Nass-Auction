@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString();
}

<nav class="navbar navbar-expand-lg navbar-light sticky-top">
    <div class="container-fluid px-4">
        <a class="navbar-brand" target="_blank" href="https://www.nasscorporation.com">
            <img src="/images/nass-logo-white.png" alt="Nass Logo" height="60" />
        </a>
        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav"
                aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
            <span class="navbar-toggler-icon"></span>
        </button>
        <div class="collapse navbar-collapse text-center" id="navbarNav">
            <!-- Changed me-auto to mx-auto -->
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                <li class="nav-item me-3">
                    <a class="text-white nav-link@(currentPage == "/Index" || currentPage == "/" ? " active" : "")"
                       asp-page="/Index">Home</a>
                </li>
                <li class="nav-item me-3">
                    <a class="text-white nav-link@(currentPage == "/VehicleDetails" ? " active" : "")"
                       asp-page="/VehicleDetails">Live Auctions</a>
                </li>
                <li class="nav-item me-3">
                    <a class="text-white nav-link@(currentPage == "/Sell" ? " active" : "")" asp-page="/Sell">Sell Your Car</a>
                </li>
                <li class="nav-item me-3">
                    <a class="text-white nav-link@(currentPage == "/HowItWorks" ? " active" : "")" asp-page="/HowItWorks">How
                        it Works</a>
                    </li>
                </ul>
                <div class="d-flex align-items-center justify-content-center">
                    <a href="#" class="btn btn-outline-light rounded-pill px-4 me-3">Login</a>
                    <a href="#" class="btn btn-outline-light rounded-pill px-4">Register</a>
                </div>
            </div>
        </div>
    </nav>